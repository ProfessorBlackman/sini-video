{
  "version": "0.4",
  "video": {
    "format": "9:16",
    "fps": 30,
    "background": "roast",
    "targetDuration": 15,
    "safeZone": "reels",
    "end": "hold",
    "seed": 7
  },
  "theme": {
    "palette": {
      "roast": "#2A1A12",
      "cocoa": "#6B4532",
      "cinnamon": "#B4572A",
      "butter": "#E8A33D",
      "cream": "#F6EADA",
      "icing": "#FFF9F0",
      "mute": "#9C8673"
    },
    "fonts": {
      "display": "Fraunces",
      "body": "Inter Tight"
    },
    "motion": "editorial",
    "transition": {
      "type": "wipe",
      "angle": 12,
      "bar": "butter",
      "duration": 0.5
    },
    "texture": {
      "grain": 0.06
    }
  },
  "assets": {
    "tray": {
      "type": "placeholder",
      "hint": "tray of cinnamon rolls coming out of the oven, steam, warm light",
      "color": "cinnamon"
    },
    "box": {
      "type": "placeholder",
      "hint": "open kraft bakery box of six cinnamon rolls, top-down",
      "color": "butter"
    },
    "roll": {
      "type": "placeholder",
      "hint": "close-up of one cinnamon roll pulled apart, icing stretching",
      "color": "cocoa"
    },
    "counter": {
      "type": "placeholder",
      "hint": "bakery counter in morning light, shallow depth of field",
      "color": "cocoa"
    }
  },
  "components": {
    "tick": {
      "params": {
        "text": ""
      },
      "root": {
        "id": "row",
        "type": "stack",
        "direction": "horizontal",
        "gap": 24,
        "align": "center",
        "children": [
          {
            "id": "dot",
            "type": "shape",
            "shape": "circle",
            "layout": {
              "width": 18,
              "height": 18
            },
            "style": {
              "fill": "cinnamon"
            }
          },
          {
            "id": "txt",
            "type": "text",
            "role": "body",
            "content": "{{text}}",
            "style": {
              "color": "cocoa",
              "size": 44,
              "weight": 500
            }
          }
        ]
      }
    }
  },
  "scenes": [
    {
      "id": "hook",
      "duration": "auto",
      "background": {
        "asset": "tray",
        "fit": "cover",
        "overlay": {
          "linear": [
            "roast/0.35",
            "roast/0.2",
            "roast/0.85"
          ],
          "angle": 180
        }
      },
      "elements": [
        {
          "id": "kicker",
          "type": "text",
          "role": "label",
          "content": "Saturday + Sunday only",
          "style": {
            "color": "butter",
            "size": 28
          },
          "layout": {
            "anchor": "top-left",
            "inset": [
              620,
              84
            ]
          },
          "enter": {
            "preset": "fadeUp",
            "at": 0.15,
            "distance": 24,
            "duration": 0.5
          }
        },
        {
          "id": "h1",
          "type": "text",
          "role": "display",
          "content": "WEEKEND\nCINNAMON\nBOX",
          "style": {
            "color": "icing"
          },
          "layout": {
            "below": "kicker",
            "gap": 36,
            "maxWidth": 850
          },
          "fit": "shrink",
          "maxLines": 3,
          "enter": {
            "preset": "lineReveal",
            "at": 0.35,
            "stagger": 0.08,
            "duration": 0.55
          }
        }
      ],
      "timeline": [
        {
          "target": "background",
          "preset": "kenBurns",
          "zoom": 1.14,
          "at": 0
        }
      ]
    },
    {
      "id": "box",
      "duration": "auto",
      "background": "roast",
      "elements": [
        {
          "id": "box-img",
          "type": "image",
          "asset": "box",
          "fit": "cover",
          "layout": {
            "anchor": "top",
            "inset": [
              260,
              0
            ],
            "width": "72%",
            "aspect": "1:1"
          },
          "style": {
            "radius": 28,
            "shadow": "deep"
          },
          "enter": {
            "preset": "scaleIn",
            "at": 0.05,
            "from": 0.86,
            "duration": 0.7
          }
        },
        {
          "id": "box-badge",
          "type": "badge",
          "label": "Weekends only",
          "shape": "pill",
          "style": {
            "fill": "butter",
            "color": "roast",
            "rotation": -9,
            "size": 26
          },
          "layout": {
            "pin": {
              "to": "box-img",
              "point": "top-right",
              "inside": 30
            }
          },
          "enter": {
            "preset": "popIn",
            "at": "box-img.enter.end-0.25",
            "duration": 0.45
          }
        },
        {
          "id": "box-copy",
          "type": "text",
          "role": "title",
          "content": "Boxed warm.\n[Every weekend.]{butter}",
          "style": {
            "color": "cream",
            "align": "center"
          },
          "layout": {
            "below": "box-img",
            "gap": 48,
            "align": "center",
            "width": "72%"
          },
          "enter": {
            "preset": "wordReveal",
            "at": "box-img.enter.end-0.15",
            "duration": 0.6,
            "stagger": 0.07
          }
        },
        {
          "id": "box-price",
          "type": "text",
          "role": "subtitle",
          "content": "GH₵ 90 a box",
          "style": {
            "color": "butter",
            "align": "center",
            "size": 46
          },
          "layout": {
            "below": "box-copy",
            "gap": 32,
            "align": "center"
          },
          "enter": {
            "preset": "fadeUp",
            "at": "box-copy.enter.end+0.05",
            "distance": 20,
            "duration": 0.5
          }
        }
      ],
      "timeline": [
        {
          "target": "box-img",
          "preset": "float",
          "amplitude": 8,
          "period": 4,
          "at": "box-img.enter.end"
        }
      ]
    },
    {
      "id": "inside",
      "duration": "auto",
      "background": "cream",
      "elements": [
        {
          "id": "h3",
          "type": "text",
          "role": "title",
          "content": "What's in\nthe box.",
          "style": {
            "color": "roast"
          },
          "layout": {
            "anchor": "top-left",
            "inset": [
              300,
              84
            ]
          },
          "enter": {
            "preset": "lineReveal",
            "at": 0.15,
            "stagger": 0.08,
            "duration": 0.55
          }
        },
        {
          "id": "items",
          "type": "stack",
          "gap": 34,
          "layout": {
            "below": "h3",
            "gap": 56
          },
          "children": [
            {
              "id": "i1",
              "use": "tick",
              "with": {
                "text": "Six buns, hand-rolled"
              }
            },
            {
              "id": "i2",
              "use": "tick",
              "with": {
                "text": "Cream-cheese icing"
              }
            },
            {
              "id": "i3",
              "use": "tick",
              "with": {
                "text": "Baked at 7am"
              }
            }
          ]
        },
        {
          "id": "roll-img",
          "type": "image",
          "asset": "roll",
          "fit": "cover",
          "layout": {
            "below": "items",
            "gap": 48,
            "width": "72%",
            "height": 620
          },
          "style": {
            "radius": 24
          },
          "enter": {
            "preset": "wipeIn",
            "from": "left",
            "at": "i3.enter.end-0.3",
            "duration": 0.6
          }
        }
      ],
      "timeline": [
        {
          "target": [
            "i1",
            "i2",
            "i3"
          ],
          "preset": "fadeUp",
          "at": "h3.enter.end",
          "stagger": 0.1,
          "distance": 28,
          "duration": 0.5
        },
        {
          "target": "roll-img",
          "preset": "kenBurns",
          "zoom": 1.1,
          "at": "roll-img.enter.end"
        }
      ]
    },
    {
      "id": "order",
      "duration": "auto",
      "transition": {
        "type": "circle",
        "origin": "center",
        "duration": 0.5
      },
      "background": "roast",
      "elements": [
        {
          "id": "order-kicker",
          "type": "text",
          "role": "label",
          "content": "Order ahead",
          "style": {
            "color": "butter"
          },
          "layout": {
            "anchor": "top-left",
            "inset": [
              250,
              84
            ]
          },
          "enter": {
            "preset": "fadeUp",
            "at": 0.1,
            "distance": 20,
            "duration": 0.5
          }
        },
        {
          "id": "phone",
          "type": "phone",
          "background": "#FFFFFF",
          "padding": 0,
          "gap": 0,
          "layout": {
            "anchor": "top",
            "inset": [
              360,
              0
            ],
            "width": 600
          },
          "enter": {
            "preset": "slideIn",
            "from": "down",
            "at": 0.15,
            "duration": 0.8
          },
          "children": [
            {
              "id": "p-img",
              "type": "image",
              "asset": "box",
              "fit": "cover",
              "layout": {
                "height": 520
              }
            },
            {
              "id": "p-body",
              "type": "stack",
              "gap": 14,
              "style": {
                "padding": [
                  26,
                  22
                ]
              },
              "children": [
                {
                  "id": "p-title",
                  "type": "text",
                  "role": "subtitle",
                  "content": "Weekend Cinnamon Box",
                  "style": {
                    "color": "roast"
                  }
                },
                {
                  "id": "p-price",
                  "type": "text",
                  "role": "body",
                  "content": "GH₵ 90",
                  "style": {
                    "color": "cinnamon",
                    "size": 22,
                    "weight": 700
                  }
                },
                {
                  "id": "p-sub",
                  "type": "text",
                  "role": "caption",
                  "content": "Pickup Saturday & Sunday, 8am–1pm",
                  "style": {
                    "color": "mute",
                    "size": 19
                  }
                },
                {
                  "id": "order-btn",
                  "type": "button",
                  "label": "Reserve a box",
                  "variant": "solid",
                  "style": {
                    "fill": "cinnamon",
                    "color": "icing",
                    "size": 20
                  },
                  "states": {
                    "done": {
                      "label": "Reserved ✓",
                      "style": {
                        "fill": "cocoa"
                      }
                    }
                  }
                }
              ]
            }
          ]
        }
      ],
      "timeline": [
        {
          "id": "tap",
          "behavior": "interaction",
          "cursor": "touch",
          "from": "bottom-right",
          "at": 0.9,
          "steps": [
            {
              "id": "press",
              "click": "order-btn"
            }
          ]
        },
        {
          "target": "order-btn",
          "state": "done",
          "at": "press.end"
        }
      ]
    },
    {
      "id": "endcard",
      "duration": "auto",
      "transition": {
        "type": "zoom",
        "direction": "in",
        "duration": 0.5
      },
      "background": {
        "asset": "counter",
        "fit": "cover",
        "overlay": {
          "linear": [
            "roast/0.72",
            "roast/0.88"
          ],
          "angle": 180
        }
      },
      "elements": [
        {
          "id": "end-stack",
          "type": "stack",
          "align": "center",
          "gap": 30,
          "layout": {
            "anchor": "center"
          },
          "children": [
            {
              "id": "wordmark",
              "type": "text",
              "role": "display",
              "content": "SWEET DOUGH",
              "style": {
                "color": "icing",
                "size": 110,
                "align": "center"
              },
              "enter": {
                "preset": "charReveal",
                "at": 0.2,
                "stagger": 0.03,
                "duration": 0.5
              }
            },
            {
              "id": "end-rule",
              "type": "shape",
              "shape": "line",
              "layout": {
                "width": 320
              },
              "style": {
                "stroke": "butter",
                "strokeWidth": 3
              },
              "enter": {
                "preset": "wipeIn",
                "at": "wordmark.enter.end-0.1",
                "duration": 0.5
              }
            },
            {
              "id": "end-sub",
              "type": "text",
              "role": "caption",
              "content": "Order by Friday · @sweetdoughgh",
              "style": {
                "color": "cream",
                "align": "center",
                "size": 30
              },
              "enter": {
                "preset": "fadeUp",
                "at": "end-rule.enter.end-0.15",
                "duration": 0.5
              }
            }
          ]
        }
      ]
    }
  ],
  "notes": [
    "Images are still placeholders: tray (oven shot), box (top-down box), roll (close-up), counter (end card). See images/README.md for the shot list.",
    "Invented copy still to confirm: 'Saturday + Sunday only', 'Six buns, hand-rolled', 'Cream-cheese icing', 'Baked at 7am', 'Pickup Saturday & Sunday, 8am-1pm', 'Order by Friday'.",
    "Confirmed by the client: Sweet Dough, @sweetdoughgh, GH₵ 90 a box."
  ]
}
