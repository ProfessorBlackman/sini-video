{
  "name": "@sini/render",
  "version": "0.1.10",
  "description": "Renders Sini plans to frames and video with Chromium (Playwright) and FFmpeg",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
