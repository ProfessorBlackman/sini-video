{
  "version": "0.4",
  "video": { "format": "9:16", "fps": 30, "background": "ink" },
  "theme": {
    "palette": {
      "night": "#1C1310", "ink": "#1E1512", "bone": "#EEE6DA", "wine": "#5B1A24",
      "wine-deep": "#28080E", "cocoa": "#6B4532", "sand": "#C9B39A"
    },
    "fonts": { "display": "Instrument Serif", "body": "Inter Tight" },
    "motion": "editorial",
    "transition": { "type": "wipe", "angle": 15, "bar": "bone", "duration": 0.55, "ease": "expo.inOut" },
    "texture": { "grain": 0.075 }
  },
  "assets": {
    "hero": { "type": "image", "src": "images/hero.jpg", "fallback": { "type": "placeholder", "hint": "model in burgundy satin, editorial", "color": "wine" } }
  },
  "scenes": [
    {
      "id": "intro",
      "duration": 3,
      "background": "night",
      "elements": [
        {
          "id": "line-1", "type": "text", "role": "display",
          "content": "YOUR CLOTHES\nHAVE A LOOK.",
          "style": { "color": "bone", "size": 168, "lineHeight": 0.9, "letterSpacing": -0.01 },
          "layout": { "anchor": "top-left", "inset": [430, 84] },
          "enter": { "preset": "wordReveal", "at": 0.08, "stagger": 0.09, "duration": 0.75 },
          "exit": { "preset": "wordsUp", "at": 2.75, "stagger": 0.03, "duration": 0.4 }
        },
        {
          "id": "site", "type": "browser", "url": "novae-seven.vercel.app", "chrome": "dark",
          "background": "night", "padding": [150, 60],
          "style": { "radius": 28 },
          "layout": { "x": 64, "y": 1010, "width": 952, "height": 520 },
          "enter": { "preset": "drawOutline", "at": 1.0, "duration": 0.75 },
          "children": [
            {
              "id": "line-2", "type": "text", "role": "body",
              "content": "YOUR WEBSITE\nSHOULD TOO.",
              "style": { "color": "bone", "size": 150, "weight": 800, "lineHeight": 0.98, "letterSpacing": -0.045 },
              "enter": { "preset": "wordReveal", "at": 1.55, "stagger": 0.08, "duration": 0.6, "ease": "back.out" }
            }
          ]
        }
      ],
      "timeline": [
        { "target": "line-1", "at": 0, "duration": 3.2, "ease": "cubic.out", "animate": { "y": [0, -30] } },
        { "target": "site", "at": 0.9, "duration": 0.7, "ease": "expo.out", "animate": { "y": [30, 0] } },
        { "target": "site", "preset": "typewriter", "at": 1.3, "cps": 40 }
      ]
    },
    {
      "id": "brand",
      "duration": 4,
      "background": { "asset": "hero", "fit": "cover", "overlay": { "radial": ["wine-deep/0.35", "wine-deep/0.75"] } },
      "elements": [
        {
          "id": "brand-block", "type": "stack", "align": "center", "gap": 30,
          "layout": { "anchor": "center", "offset": [0, -40] },
          "children": [
            {
              "id": "mark", "type": "text", "role": "display", "content": "NOVAÉ",
              "style": { "color": "bone", "size": 300, "letterSpacing": 0.035, "lineHeight": 1 },
              "enter": { "preset": "charReveal", "at": 0.35, "stagger": 0.07, "duration": 0.85 }
            },
            {
              "id": "sub", "type": "text", "role": "subtitle", "content": "*A fashion ecommerce concept.*",
              "style": { "color": "bone", "size": 66, "align": "center" },
              "enter": { "preset": "wordReveal", "at": 1.75, "stagger": 0.06, "duration": 0.8 }
            },
            {
              "id": "rule", "type": "shape", "shape": "line",
              "style": { "stroke": "bone/0.6", "strokeWidth": 2 },
              "layout": { "width": 360 }
            },
            {
              "id": "tag", "type": "button", "variant": "outline", "label": "Concept project by Cualitas",
              "style": { "color": "bone", "stroke": "bone/0.55", "size": 24, "weight": 400, "radius": 40 },
              "enter": { "preset": "fadeUp", "at": 2.5, "distance": 20, "duration": 0.6, "ease": "cubic.out" }
            }
          ]
        },
        {
          "id": "city", "type": "text", "role": "caption", "content": "Accra",
          "style": { "color": "bone/0.75", "size": 24 },
          "layout": { "anchor": "top-left", "inset": [96, 72] },
          "enter": { "preset": "fadeIn", "at": 0.9, "duration": 0.6, "ease": "cubic.out" }
        },
        {
          "id": "edit", "type": "text", "role": "caption", "content": "The everyday edit",
          "style": { "color": "bone/0.75", "size": 24 },
          "layout": { "anchor": "top-right", "inset": [96, 72] },
          "enter": { "preset": "fadeIn", "at": 1.0, "duration": 0.6, "ease": "cubic.out" }
        }
      ],
      "timeline": [
        { "target": "background", "preset": "kenBurns", "zoom": 1.08, "at": 0 },
        { "target": "mark", "preset": "trackIn", "from": 0.385, "at": 0.35, "duration": 1.25, "ease": "expo.out" },
        { "target": "rule", "at": 2.2, "duration": 0.8, "ease": "expo.out", "animate": { "scaleX": [0, 1] } },
        { "target": "brand-block", "at": 1.6, "duration": 2.7, "ease": "cubic.inOut", "animate": { "scale": [1, 1.06] } }
      ]
    }
  ],
  "notes": [
    "Scenes 1–2 of the Novaé × Cualitas reel, recreated in the Sini DSL.",
    "Drop the real hero photo at images/hero.jpg; until then a placeholder is used."
  ]
}
