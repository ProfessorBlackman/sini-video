{
  "version": "0.4",
  "video": {
    "format": "9:16",
    "fps": 30,
    "background": "ink",
    "safeZone": "reels",
    "targetDuration": 15,
    "end": {
      "type": "fade",
      "duration": 0.8,
      "color": "#1C1A17"
    }
  },
  "theme": {
    "palette": {
      "ink": "#1C1A17",
      "bone": "#EFE9E1",
      "stone": "#8A8178",
      "clay": "#A9876C",
      "sage": "#7D8471",
      "umber": "#5A4636"
    },
    "fonts": {
      "display": "Instrument Serif",
      "body": "Inter Tight"
    },
    "motion": "calm",
    "transition": {
      "type": "crossfade",
      "duration": 0.8
    },
    "texture": {
      "grain": 0.06,
      "vignette": 0.15
    }
  },
  "assets": {
    "photo-1": {
      "type": "placeholder",
      "hint": "Ama photo 1 - portrait, warm light",
      "color": "clay"
    },
    "photo-2": {
      "type": "placeholder",
      "hint": "Ama photo 2 - hero image, opens full screen",
      "color": "umber"
    },
    "photo-3": {
      "type": "placeholder",
      "hint": "Ama photo 3 - landscape or detail",
      "color": "sage"
    }
  },
  "scenes": [
    {
      "id": "triptych",
      "duration": 5,
      "background": "bone",
      "elements": [
        {
          "id": "kicker",
          "type": "text",
          "role": "label",
          "content": "Ama Owusu Photography",
          "style": {
            "color": "umber",
            "align": "center",
            "size": 26
          },
          "layout": {
            "anchor": "top",
            "inset": [
              260,
              0
            ]
          },
          "enter": {
            "preset": "fadeIn",
            "at": 0.2,
            "duration": 1
          }
        },
        {
          "id": "strip",
          "type": "stack",
          "direction": "horizontal",
          "gap": 20,
          "layout": {
            "anchor": "center"
          },
          "children": [
            {
              "id": "strip-1",
              "type": "image",
              "asset": "photo-1",
              "fit": "cover",
              "layout": {
                "width": 296,
                "height": 700
              }
            },
            {
              "id": "strip-2",
              "type": "image",
              "asset": "photo-2",
              "fit": "cover",
              "layout": {
                "width": 296,
                "height": 700
              }
            },
            {
              "id": "strip-3",
              "type": "image",
              "asset": "photo-3",
              "fit": "cover",
              "layout": {
                "width": 296,
                "height": 700
              }
            }
          ]
        },
        {
          "id": "caption",
          "type": "text",
          "role": "subtitle",
          "content": "*Selected work*",
          "style": {
            "color": "ink",
            "align": "center"
          },
          "layout": {
            "below": "strip",
            "gap": 56,
            "align": "center"
          },
          "enter": {
            "preset": "fadeUp",
            "at": 1.6,
            "distance": 24
          }
        }
      ],
      "timeline": [
        {
          "id": "strips-in",
          "target": [
            "strip-1",
            "strip-2",
            "strip-3"
          ],
          "preset": "fadeUp",
          "distance": 60,
          "stagger": 0.25,
          "at": 0.4,
          "duration": 1.2,
          "ease": "cubic.out"
        },
        {
          "target": [
            "strip-1",
            "strip-3"
          ],
          "at": "strips-in.end+1.0",
          "duration": 0.6,
          "animate": {
            "opacity": [
              1,
              0.35
            ]
          },
          "ease": "cubic.inOut"
        },
        {
          "target": "strip",
          "preset": "drift",
          "x": 0,
          "y": -20,
          "at": 0.4
        }
      ]
    },
    {
      "id": "open",
      "duration": 4.2,
      "transition": {
        "type": "matchCut",
        "from": "strip-2",
        "to": "background",
        "duration": 1,
        "ease": "expo.inOut"
      },
      "background": {
        "asset": "photo-2",
        "fit": "cover",
        "overlay": {
          "linear": [
            "ink/0",
            "ink/0",
            "ink/0.35"
          ],
          "angle": 180
        }
      },
      "elements": [],
      "timeline": [
        {
          "target": "background",
          "preset": "kenBurns",
          "zoom": 1.08,
          "at": 0
        }
      ]
    },
    {
      "id": "signoff",
      "duration": "auto",
      "background": "bone",
      "elements": [
        {
          "id": "sign-block",
          "type": "stack",
          "align": "center",
          "gap": 40,
          "layout": {
            "anchor": "center"
          },
          "children": [
            {
              "id": "name",
              "type": "text",
              "role": "display",
              "content": "Ama Owusu",
              "style": {
                "color": "ink",
                "align": "center",
                "size": 190
              },
              "enter": {
                "preset": "blurIn",
                "at": 0.4,
                "duration": 1.2
              }
            },
            {
              "id": "discipline",
              "type": "text",
              "role": "label",
              "content": "Photography",
              "style": {
                "color": "umber",
                "align": "center",
                "size": 26
              },
              "enter": {
                "preset": "fadeIn",
                "at": 1
              }
            },
            {
              "id": "rule",
              "type": "shape",
              "shape": "line",
              "layout": {
                "width": 220
              },
              "style": {
                "stroke": "ink/0.4",
                "strokeWidth": 2
              },
              "enter": {
                "preset": "wipeIn",
                "at": 1.3,
                "duration": 1
              }
            },
            {
              "id": "bookings",
              "type": "text",
              "role": "subtitle",
              "content": "Bookings open for *2027*",
              "style": {
                "color": "ink",
                "align": "center"
              },
              "enter": {
                "preset": "fadeUp",
                "at": 1.7,
                "distance": 24
              }
            }
          ]
        }
      ],
      "timeline": [
        {
          "target": "sign-block",
          "preset": "drift",
          "x": 0,
          "y": -16,
          "scale": 1.03,
          "at": 0.5
        }
      ]
    }
  ],
  "notes": [
    "Photos are placeholders: send three images. photo-2 (middle) is the one that opens to full screen, so pick your strongest vertical shot.",
    "'Selected work' is copy I added under the triptych; remove it if you prefer."
  ]
}
