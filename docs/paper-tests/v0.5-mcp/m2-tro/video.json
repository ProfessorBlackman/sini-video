                      }
                    ]
                  },
                  {
                    "id": "drv-call",
                    "type": "icon",
                    "name": "phone",
                    "style": {
                      "color": "leaf",
                      "size": 24
                    }
                  }
                ]
              },
              {
                "id": "trip-card",
                "type": "stack",
                "direction": "horizontal",
                "align": "center",
                "gap": 12,
                "style": {
                  "padding": [
                    4,
                    4
                  ]
                },
                "children": [
                  {
                    "id": "trip-ico",
                    "type": "icon",
                    "name": "map-pin",
                    "style": {
                      "color": "coral",
                      "size": 22
                    }
                  },
                  {
                    "id": "trip-txt",
                    "type": "stack",
                    "gap": 2,
                    "layout": {
                      "grow": 1
                    },
                    "children": [
                      {
                        "id": "trip-to",
                        "type": "text",
                        "role": "body",
                        "content": "Oxford Street, Osu",
                        "style": {
                          "color": "ink",
                          "weight": 700
                        }
                      },
                      {
                        "id": "trip-pay",
                        "type": "text",
                        "role": "caption",
                        "content": "Tro Pool · GH₵ 19 · Mobile Money",
                        "style": {
                          "color": "mute",
                          "size": 15
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "id": "msg-btn",
                "type": "button",
                "label": "Message Kwame",
                "variant": "outline",
                "style": {
                  "color": "ink",
                  "stroke": "line"
                }
              }
            ]
          }
        }
      ],
      "timeline": [
        {
          "id": "pick",
          "behavior": "interaction",
          "cursor": "touch",
          "from": "bottom-right",
          "at": 1,
          "steps": [
            {
              "id": "type-dest",
              "type": "dest-text",
              "text": "Oxford St",
              "set": {
                "dest-text": "typing"
              }
            },
            {
              "wait": 0.2
            },
            {
              "id": "tap-osu",
              "click": "sug-osu",
              "set": {
                "sug-osu": "pressed"
              },
              "navigate": {
                "phone": "rides"
              }
            }
          ]
        },
        {
          "target": "step-title",
          "state": "rides",
          "at": "tap-osu.end-0.2"
        },
        {
          "id": "scroll-rides",
          "behavior": "scroll",
          "target": "phone",
          "to": "opt-pool",
          "at": "pick.end+0.25",
          "duration": 1,
          "ease": "cubic.inOut"
        },
        {
          "target": "step-title",
          "state": "cheap",
          "at": "scroll-rides.end"
        },
        {
          "id": "choose",
          "behavior": "interaction",
          "cursor": "touch",
          "from": "bottom-right",
          "at": "scroll-rides.end+0.1",
          "steps": [
            {
              "id": "tap-pool",
              "click": "opt-pool",
              "set": {
                "opt-pool": "selected"
              }
            },
            {
              "wait": 0.3
            },
            {
              "id": "tap-confirm",
              "click": "confirm-btn",
              "navigate": {
                "phone": "tracking"
              }
            }
          ]
        },
        {
          "target": "step-title",
          "state": "track",
          "at": "tap-confirm.end-0.2"
        },
        {
          "id": "prog-1",
          "target": "trk-progress",
          "at": "choose.end+0.6",
          "duration": 0.8,
          "animate": {
            "value": 1
          }
        },
        {
          "target": "trk-status",
          "state": "way",
          "at": "choose.end+0.8"
        },
        {
          "id": "drive",
          "target": "trk-map/car",
          "at": "choose.end+0.4",
          "duration": 2.4,
          "ease": "cubic.inOut",
          "animate": {
            "x": [
              0,
              218
            ],
            "y": [
              0,
              -50
            ]
          }
        },
        {
          "id": "prog-2",
          "target": "trk-progress",
          "at": "choose.end+2.2",
          "duration": 0.8,
          "animate": {
            "value": 2
          }
        },
        {
          "target": "trk-status",
          "state": "here",
          "at": "choose.end+2.4"
        }
      ],
      "transition": {
        "type": "slide",
        "from": "down",
        "push": true,
        "duration": 0.6,
        "ease": "expo.inOut"
      }
    },
    {
      "id": "outro",
      "duration": 2.8,
      "background": "ink",
      "transition": {
        "type": "circle",
        "duration": 0.55
      },
      "elements": [
        {
          "id": "end-block",
          "type": "stack",
          "align": "center",
          "gap": 28,
          "layout": {
            "anchor": "center"
          },
          "children": [
            {
              "id": "end-car",
              "type": "icon",
              "name": "car-front",
              "style": {
                "color": "sun",
                "size": 96,
                "strokeWidth": 2.2
              },
              "enter": {
                "preset": "popIn",
                "at": 0.1
              }
            },
            {
              "id": "end-mark",
              "type": "text",
              "role": "display",
              "content": "tro",
              "style": {
                "color": "sun",
                "size": 240,
                "weight": 800,
                "letterSpacing": -0.04
              },
              "enter": {
                "preset": "popIn",
                "at": 0.2
              }
            },
            {
              "id": "end-line",
              "type": "text",
              "role": "subtitle",
              "content": "Your ride across Accra.",
              "style": {
                "color": "paper",
                "align": "center"
              },
              "enter": {
                "preset": "fadeUp",
                "at": 0.4
              }
            },
            {
              "id": "end-cta",
              "type": "button",
              "label": "Get the app",
              "variant": "solid",
              "style": {
                "fill": "sun",
                "color": "ink",
                "weight": 800
              },
              "enter": {
                "preset": "popIn",
                "at": 0.6
              }
            }
          ]
        }
      ],
      "timeline": [
        {
          "target": "end-cta",
          "preset": "pulse",
          "at": 1.6,
          "scale": 1.05
        }
      ]
    }
  ],
  "notes": [
    "Brand 'Tro' visuals, tagline, CTA, prices (GH₵ 19–85), ride tiers, user name Ama, driver Kwame M., car and plate, and ETAs are all invented placeholders.",
    "'Shared rides from GH₵ 19' promo copy is invented."
  ]
}
