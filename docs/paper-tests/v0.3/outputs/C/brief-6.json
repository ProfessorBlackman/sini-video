{
  "version": "0.3",
  "video": { "format": "4:5", "fps": 30, "background": "ink", "end": "hold" },
  "theme": {
    "palette": {
      "ink": "#15120E",
      "cream": "#F5EFE4",
      "brass": "#C39A5A",
      "stone": "#8C8275"
    },
    "fonts": { "display": "DM Serif Display", "body": "Manrope" },
    "motion": "editorial",
    "transition": { "type": "wipe", "from": "left", "angle": 12, "bar": "brass", "duration": 0.5 },
    "texture": { "grain": 0.04, "vignette": 0.2 }
  },
  "assets": {
    "living": { "type": "image", "src": "assets/living.jpg",
                "fallback": { "type": "placeholder", "hint": "apartment living room, East Legon", "color": "stone" } },
    "kitchen": { "type": "image", "src": "assets/kitchen.jpg",
                 "fallback": { "type": "placeholder", "hint": "apartment kitchen", "color": "cream" } },
    "bedroom": { "type": "image", "src": "assets/bedroom.jpg",
                 "fallback": { "type": "placeholder", "hint": "apartment bedroom", "color": "brass" } }
  },
  "components": {
    "room-panel": {
      "params": { "photo": "", "name": "" },
      "root": {
        "id": "panel",
        "type": "group",
        "children": [
          { "id": "photo", "type": "image", "asset": "{{photo}}", "fit": "cover",
            "layout": { "anchor": "center", "width": "100%", "height": "100%" } },
          { "id": "tag", "type": "stack", "direction": "vertical",
            "layout": { "anchor": "bottom-left", "inset": [40, 72] },
            "style": { "fill": "ink/0.6", "radius": 16, "padding": [16, 28] },
            "children": [
              { "id": "name", "type": "text", "role": "subtitle", "content": "{{name}}",
                "style": { "color": "cream", "size": 52 } }
            ] }
        ]
      }
    },
    "feature-row": {
      "params": { "text": "" },
      "root": {
        "id": "row",
        "type": "stack",
        "direction": "horizontal",
        "align": "center",
        "gap": 20,
        "children": [
          { "id": "dot", "type": "shape", "shape": "circle",
            "layout": { "width": 14, "height": 14 }, "style": { "fill": "brass" } },
          { "id": "text", "type": "text", "role": "body", "content": "{{text}}",
            "style": { "color": "ink" } }
        ]
      }
    }
  },
  "scenes": [
    {
      "id": "hero",
      "duration": 3.6,
      "background": {
        "asset": "living", "fit": "cover",
        "overlay": { "linear": ["ink/0.35", "ink/0", "ink/0.8"], "angle": 180 }
      },
      "elements": [
        {
          "id": "for-rent",
          "type": "stack",
          "direction": "horizontal",
          "layout": { "anchor": "top-left", "inset": [84, 84] },
          "style": { "fill": "brass", "radius": 40, "padding": [12, 22] },
          "enter": { "preset": "fadeIn", "at": 0.3, "duration": 0.6 },
          "children": [
            { "id": "for-rent-txt", "type": "text", "role": "label", "content": "For rent",
              "style": { "color": "ink", "weight": 700 } }
          ]
        },
        {
          "id": "hero-title",
          "type": "text",
          "role": "title",
          "content": "3-bedroom\napartment.",
          "style": { "color": "cream" },
          "layout": { "anchor": "bottom-left", "inset": [200, 84] },
          "enter": { "preset": "wordReveal", "at": 0.5 }
        },
        {
          "id": "hero-loc",
          "type": "text",
          "role": "body",
          "content": "East Legon",
          "style": { "color": "cream/0.85" },
          "layout": { "below": "hero-title", "gap": 24 },
          "enter": { "preset": "fadeUp", "at": "hero-title.enter.end-0.2", "distance": 24 }
        }
      ],
      "timeline": [
        { "target": "background", "preset": "kenBurns", "zoom": 1.1, "pan": [-40, -20], "at": 0 }
      ]
    },
    {
      "id": "gallery",
      "duration": 3.4,
      "background": "ink",
      "elements": [
        {
          "id": "gallery-stack",
          "type": "stack",
          "direction": "vertical",
          "align": "stretch",
          "gap": 12,
          "layout": { "anchor": "center", "width": "100%", "height": "100%" },
          "children": [
            { "id": "kitchen-panel", "use": "room-panel", "with": { "photo": "kitchen", "name": "Kitchen" },
              "layout": { "width": "100%", "height": 669 },
              "enter": { "preset": "wipeIn", "from": "left", "at": 0.15, "duration": 0.8 } },
            { "id": "bedroom-panel", "use": "room-panel", "with": { "photo": "bedroom", "name": "Bedroom" },
              "layout": { "width": "100%", "height": 669 },
              "enter": { "preset": "wipeIn", "from": "right", "at": 0.45, "duration": 0.8 } }
          ]
        }
      ],
      "timeline": [
        { "target": "kitchen-panel/photo", "preset": "kenBurns", "zoom": 1.08, "pan": [-30, 0], "at": 0.15 },
        { "target": "bedroom-panel/photo", "preset": "kenBurns", "zoom": 1.08, "pan": [30, 0], "at": 0.45 },
        { "target": "kitchen-panel/tag", "preset": "fadeUp", "at": 0.9, "duration": 0.6, "distance": 20 },
        { "target": "bedroom-panel/tag", "preset": "fadeUp", "at": 1.2, "duration": 0.6, "distance": 20 }
      ]
    },
    {
      "id": "details",
      "duration": 4.4,
      "background": "cream",
      "transition": { "type": "slide", "from": "down", "push": true, "duration": 0.6 },
      "elements": [
        {
          "id": "details-stack",
          "type": "stack",
          "direction": "vertical",
          "align": "start",
          "gap": 28,
          "layout": { "anchor": "left", "inset": [0, 84], "width": 912 },
          "children": [
            { "id": "rent-kicker", "type": "text", "role": "label", "content": "Monthly rent · East Legon",
              "style": { "color": "brass" },
              "enter": { "preset": "fadeUp", "at": 0.7, "duration": 0.6, "distance": 20 } },
            {
              "id": "price-row",
              "type": "stack",
              "direction": "horizontal",
              "align": "baseline",
              "gap": 16,
              "children": [
                { "id": "price", "type": "text", "role": "display", "content": "GH₵ 4,500",
                  "style": { "color": "ink", "size": 130 },
                  "enter": { "preset": "countUp", "from": 0, "at": 0.8, "duration": 1.2, "ease": "expo.out" } },
                { "id": "per-month", "type": "text", "role": "subtitle", "content": "/month",
                  "style": { "color": "stone" },
                  "enter": { "preset": "fadeIn", "at": "price.enter.end-0.4", "duration": 0.6 } }
              ]
            },
            { "id": "price-rule", "type": "shape", "shape": "line",
              "layout": { "width": 120 }, "style": { "stroke": "brass", "strokeWidth": 3 },
              "enter": { "preset": "wipeIn", "from": "left", "at": 1.6, "duration": 0.7 } },
            {
              "id": "features",
              "type": "stack",
              "direction": "vertical",
              "align": "start",
              "gap": 22,
              "children": [
                { "id": "f-beds", "use": "feature-row", "with": { "text": "3 bedrooms" } },
                { "id": "f-living", "use": "feature-row", "with": { "text": "Living room" } },
                { "id": "f-kitchen", "use": "feature-row", "with": { "text": "Kitchen" } }
              ]
            }
          ]
        }
      ],
      "timeline": [
        { "target": ["f-beds", "f-living", "f-kitchen"], "preset": "fadeUp", "at": 2.0,
          "duration": 0.6, "stagger": 0.15, "distance": 24 }
      ]
    },
    {
      "id": "cta",
      "duration": 3.6,
      "background": { "asset": "living", "fit": "cover", "overlay": "ink/0.65", "blur": 14 },
      "elements": [
        {
          "id": "cta-block",
          "type": "stack",
          "direction": "vertical",
          "align": "center",
          "gap": 30,
          "layout": { "anchor": "center" },
          "children": [
            { "id": "cta-kicker", "type": "text", "role": "label", "content": "East Legon · 3 bedrooms",
              "style": { "color": "brass", "align": "center" },
              "enter": { "preset": "fadeIn", "at": 0.55, "duration": 0.6 } },
            { "id": "cta-price", "type": "text", "role": "subtitle", "content": "GH₵ 4,500/month",
              "style": { "color": "cream", "align": "center" },
              "enter": { "preset": "wordReveal", "at": 0.8 } },
            { "id": "cta-btn", "type": "button", "variant": "solid", "label": "Book a viewing",
              "style": { "fill": "brass", "color": "ink", "size": 40, "radius": 48 },
              "enter": { "preset": "scaleIn", "at": 1.4, "duration": 0.7 } }
          ]
        }
      ],
      "timeline": [
        { "target": "background", "preset": "kenBurns", "zoom": 1.06, "at": 0 },
        { "target": "cta-btn", "preset": "pulse", "ring": true, "scale": 1.04, "every": 0.9, "at": "cta-btn.enter.end+0.1" }
      ]
    }
  ],
  "notes": [
    "Features are limited to what the brief states or the photos imply: 3 bedrooms, living room, kitchen. Add bathrooms, parking, furnishing, security etc. if you want them shown.",
    "No phone number, WhatsApp or link was given, so the 'Book a viewing' scene has no contact details. Please supply one.",
    "'For rent' and 'Monthly rent' labels are my wording, inferred from the GH₵ 4,500/month price.",
    "Photos are used as given; if any file is missing a placeholder will show."
  ]
}
