{
  "version": "0.3",
  "video": { "format": "16:9", "fps": 30, "background": "#1a1a1a", "targetDuration": 20 },
  "theme": {
    "palette": {
      "dark": "#1a1a1a",
      "light": "#FFFFFF",
      "primary": "#2E7D32",
      "accent": "#FF9800",
      "mute": "#888888"
    },
    "fonts": { "display": "Space Grotesk", "body": "Inter Tight" },
    "motion": "calm",
    "transition": { "type": "crossfade", "duration": 0.45 },
    "texture": { "grain": 0.06 }
  },
  "scenes": [
    {
      "id": "impact-stats",
      "duration": "auto",
      "background": "dark",
      "elements": [
        {
          "id": "heading",
          "type": "text",
          "role": "display",
          "content": "This year's\nimpact",
          "style": { "color": "light" },
          "layout": { "anchor": "top", "inset": [120, 100], "maxWidth": "85%" }
        },
        {
          "id": "stats-container",
          "type": "grid",
          "columns": 3,
          "gap": 48,
          "layout": {
            "anchor": "center",
            "inset": [80, 100],
            "width": "88%"
          },
          "enter": "fadeUp",
          "children": [
            {
              "id": "stat-meals",
              "type": "stack",
              "align": "center",
              "gap": 16,
              "style": {
                "fill": "primary/0.12",
                "radius": 20,
                "padding": 40
              },
              "children": [
                {
                  "id": "meals-num",
                  "type": "text",
                  "role": "title",
                  "content": "12,000",
                  "style": { "color": "primary", "weight": 700 },
                  "enter": { "preset": "countUp", "from": 0, "duration": 1.2, "at": 0.4 }
                },
                {
                  "id": "meals-label",
                  "type": "text",
                  "role": "label",
                  "content": "MEALS SERVED",
                  "style": { "color": "mute" },
                  "enter": "none"
                }
              ]
            },
            {
              "id": "stat-volunteers",
              "type": "stack",
              "align": "center",
              "gap": 16,
              "style": {
                "fill": "accent/0.12",
                "radius": 20,
                "padding": 40
              },
              "children": [
                {
                  "id": "volunteers-num",
                  "type": "text",
                  "role": "title",
                  "content": "340",
                  "style": { "color": "accent", "weight": 700 },
                  "enter": { "preset": "countUp", "from": 0, "duration": 1.2, "at": "prev.enter.end+0.15" }
                },
                {
                  "id": "volunteers-label",
                  "type": "text",
                  "role": "label",
                  "content": "VOLUNTEERS",
                  "style": { "color": "mute" },
                  "enter": "none"
                }
              ]
            },
            {
              "id": "stat-communities",
              "type": "stack",
              "align": "center",
              "gap": 16,
              "style": {
                "fill": "primary/0.12",
                "radius": 20,
                "padding": 40
              },
              "children": [
                {
                  "id": "communities-num",
                  "type": "text",
                  "role": "title",
                  "content": "18",
                  "style": { "color": "primary", "weight": 700 },
                  "enter": { "preset": "countUp", "from": 0, "duration": 1.2, "at": "prev.enter.end+0.15" }
                },
                {
                  "id": "communities-label",
                  "type": "text",
                  "role": "label",
                  "content": "COMMUNITIES",
                  "style": { "color": "mute" },
                  "enter": "none"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "quarterly-breakdown",
      "duration": "auto",
      "background": "dark",
      "transition": { "type": "crossfade", "duration": 0.4 },
      "elements": [
        {
          "id": "chart-title",
          "type": "text",
          "role": "subtitle",
          "content": "Meals served by quarter",
          "style": { "color": "light" },
          "layout": { "anchor": "top", "inset": [100, 100] }
        },
        {
          "id": "meals-chart",
          "type": "chart",
          "kind": "bar",
          "data": [["Q1", 2100], ["Q2", 2800], ["Q3", 3300], ["Q4", 3800]],
          "highlight": "Q4",
          "format": "0,0",
          "style": { "fill": "primary", "stroke": "accent", "color": "light" },
          "layout": {
            "anchor": "center",
            "inset": [60, 100],
            "width": "88%",
            "height": 480
          },
          "enter": { "preset": "grow", "at": 0.5, "duration": 0.9, "stagger": 0.18 }
        }
      ]
    }
  ],
  "notes": [
    "Nonprofit branding colours are inferred: primary green (#2E7D32) and accent orange (#FF9800) chosen for impact/energy feel. Replace with actual brand colours.",
    "All numeric data (12,000 meals, 340 volunteers, 18 communities, quarterly breakdown 2100/2800/3300/3800) comes directly from brief.",
    "Stat cards use countUp preset with staggered entry: each number counts up over 1.2s, with 0.15s gap between each card's start.",
    "Chart bars grow from baseline with 0.18s stagger; Q4 is highlighted as the peak quarter.",
    "Grid layout is 3 columns (meals | volunteers | communities) chosen for landscape 16:9 format; alternative would be 2 rows × 1.5 per row.",
    "Motion personality set to 'calm' (cubic.inOut easing, 1.1s enter duration) to suit nonprofit/year-in-review tone."
  ]
}
